# Copy this file to .env in the home folder to change where podcast-generator
# looks for scripts and writes audio. The home folder is podcast_generator in
# your Documents folder after a pip install, or the repo folder for a source
# checkout (or PODCAST_GENERATOR_HOME, if set). The Podcast Watch app
# (podcast-watch) can also edit these for you. All settings are optional; if
# unset, the home folder's own inputs/, outputs/ and script_archive/ are used.
# The same folders are used for manual and scheduled runs.

PODCAST_INPUTS_DIR=C:\Users\yourname\Sync\podcasts\inputs
PODCAST_OUTPUTS_DIR=C:\Users\yourname\Sync\podcasts\outputs
PODCAST_ARCHIVE_DIR=C:\Users\yourname\Sync\podcasts\script_archive

# Where scripts queued by the Claude Desktop connector (podcast-generator-mcp)
# wait to be converted. Kept apart from the inputs folder so the watch and the
# connector never convert each other's scripts. Default: connector_queue/ in
# the home folder. Converted scripts still go to the archive folder above.
# PODCAST_CONNECTOR_QUEUE_DIR=C:\Users\yourname\podcasts\connector_queue

# Used by the Podcast Watch app (scripts/podcast-watch.ps1): on or off forces
# the watch task to that state whenever the app opens. Unset = leave it as is.
# PODCAST_WATCH_ON_OPEN=on
