# Copy this file to .env to override where generator.py looks for scripts
# and writes audio. The Podcast Watch app (scripts/podcast-watch.ps1) can
# also edit these for you. All three folder settings are optional — if unset, generator.py uses
# script-relative inputs/, outputs/, and script_archive/ folders instead.
# The same folders are used whether generator.py is run manually or on a
# schedule (see README.md).
#
# Example: point these at a folder mirrored by a cloud sync client, so
# scripts dropped remotely get picked up and finished audio syncs back out.

PODCAST_INPUTS_DIR=C:\Users\yourname\Sync\podcasts\inputs
PODCAST_OUTPUTS_DIR=C:\Users\yourname\Sync\podcasts\outputs
PODCAST_ARCHIVE_DIR=C:\Users\yourname\Sync\podcasts\script_archive

# Used by the Podcast Watch app (scripts/podcast-watch.ps1): on or off forces
# the watch task to that state whenever the app opens. Unset = leave it as is.
# PODCAST_WATCH_ON_OPEN=on
